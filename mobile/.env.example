# Distill mobile — environment variables
#
# Required for LAN dev. EXPO_PUBLIC_* keys are baked into the JS
# bundle and exposed to the client.

# Where the Distill server is reachable from your phone.
# - LAN: your laptop's IP, e.g. http://192.168.1.42:3000
# - Tailscale: your tailnet hostname, e.g. http://distill-laptop:3000
# - Production: your deployed HTTPS URL, e.g. https://distill.example.com
EXPO_PUBLIC_DISTILL_API_URL=
