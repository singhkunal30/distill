{
  "expo": {
    "name": "Distill",
    "slug": "distill",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "distill",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.distill.app",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.distill.app",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "distillApiUrl": "http://localhost:3000"
    }
  }
}
