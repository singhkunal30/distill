# ─────────────────────────────────────────────────────────────────
# Distill — environment variables
#
# All variables are OPTIONAL. With none set, the app boots in demo
# mode and runs against pre-cached AI fixtures. Add keys only when
# you want to switch to live generation.
# ─────────────────────────────────────────────────────────────────

# Database (SQLite). Default: ./prisma/distill.db
DATABASE_URL="file:./distill.db"

# Single-passcode gate. If unset, no auth is required (localhost dev).
# Set to any string when you install the PWA on your phone or expose
# the app over LAN / Tailscale / Vercel.
DISTILL_PASSCODE=

# Random secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required if DISTILL_PASSCODE is set.
DISTILL_SESSION_SECRET=

# ─── AI providers (optional; demo mode runs without them) ────────

# Anthropic (Claude). Used for summaries, chat, flashcards, quizzes.
ANTHROPIC_API_KEY=

# OpenAI. Used for TTS and (optionally) embeddings.
OPENAI_API_KEY=

# ElevenLabs (alternative TTS provider).
ELEVENLABS_API_KEY=

# ─── Model selection (defaults are documented in COSTS.md) ───────

DISTILL_MODEL_SUMMARY="claude-opus-4-7"
DISTILL_MODEL_CHAT="claude-sonnet-4-6"
DISTILL_MODEL_QUICK="claude-haiku-4-5-20251001"

# Embeddings provider: "openai" or "local"
DISTILL_EMBEDDINGS_PROVIDER="local"

# TTS provider: "openai" or "elevenlabs"
DISTILL_TTS_PROVIDER="openai"

# ─── Cost controls ───────────────────────────────────────────────

# Monthly budget cap in USD. Generation jobs that would exceed this
# require manual override. Default: 25 USD.
DISTILL_MONTHLY_BUDGET_USD="25"

# Force demo mode regardless of settings/keys. Useful for screenshots
# and offline development.
DISTILL_FORCE_DEMO_MODE="false"
